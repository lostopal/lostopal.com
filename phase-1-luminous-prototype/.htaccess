# Keep missing URLs inside the Lost Opal experience instead of handing visitors
# to the hosting provider's generic error page.
ErrorDocument 404 /not_found.html

# The memorable Nuncastra subdomain is a doorway into the tool while the
# application remains part of the main Lost Opal site and source tree.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^nuncastra\.lostopal\.com$ [NC]
  RewriteRule ^ https://lostopal.com/nuncastra/ [R=302,L]
</IfModule>

# Keep optimized artwork and application assets in the visitor's cache. The
# release uses cache-busted CSS/JS URLs, while a seven-day window prevents
# unversioned visual assets from becoming difficult to replace.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|wasm|se1|webp|png|ico|svg|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/wasm "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType font/ttf "access plus 7 days"
  ExpiresByType font/woff2 "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
